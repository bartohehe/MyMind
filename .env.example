# Skopiuj do `.env` i zmień hasło. docker compose czyta ten plik automatycznie,
# a `npm run dev` bierze stąd DATABASE_URL (Next też ładuje .env).
#
# Baza nie jest wystawiona na sieć domową (port tylko na 127.0.0.1), ale własne
# hasło i tak warto ustawić. Zmiana hasła PO pierwszym starcie nie zadziała —
# Postgres czyta je tylko przy inicjalizacji pustego wolumenu.

POSTGRES_USER=mymind
POSTGRES_PASSWORD=zmien-mnie
POSTGRES_DB=mymind

# Dla `npm run dev` na hoście (baza z `docker compose up -d db`).
DATABASE_URL=postgres://mymind:zmien-mnie@localhost:5432/mymind
